# 실제 값은 여기 아닌 .env(커밋 금지)에 채운다. 이 파일은 키 이름만 공유하는 템플릿이다.

# docker-compose.yml의 POSTGRES_USER/PASSWORD/DB와 반드시 일치해야 한다.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_copilot

# 공고 추출(extractor.py), 임베딩 매칭(matcher.py)에서 사용할 OpenAI API 키.
OPENAI_API_KEY=

# React 개발 서버 → FastAPI 호출을 허용할 CORS origin. 포트가 다르면 이 값도 바꿔야 한다.
CORS_ORIGIN=http://localhost:5173
